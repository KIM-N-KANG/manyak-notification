### 동기 알림 발송 API 검증
### 준비: 서버 내부 자격 조회·토큰 삭제·결과 보고 API, 세 환경변수 설정 후 SERVER_PORT=8081 ./gradlew bootRun.
### internalSecret은 커밋하지 않는 IntelliJ HTTP 환경 파일에 넣습니다.
### recipientId는 테스트 전용 회원 publicId입니다. 유효 요청은 실제 기기에 알림을 보냅니다.
@baseUrl = http://localhost:8081
@serverBaseUrl = http://localhost:8080
@recipientId = 00000000-0000-4000-8000-000000000001

### 헬스체크
GET {{baseUrl}}/actuator/health

> {%
    client.test("기동 확인", () => client.assert(response.status === 200, `expected=200 actual=${response.status}`));
%}

### 만료 요청: 자격 조회와 발송 없이 EXPIRED
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{"recipientId":"{{recipientId}}","kind":"SERVICE","type":"STORY_COMPLETED","data":{},"expiresAt":"2000-01-01T00:00:00Z"}

> {%
    client.test("만료", () => client.assert(response.status === 200 && response.body.outcome === "EXPIRED", `expected=200/EXPIRED actual=${response.status}/${response.body.outcome}`));
%}

### 시크릿 헤더 누락
POST {{baseUrl}}/internal/notifications
Content-Type: application/json

{}

> {%
    client.test("인증 거절", () => client.assert(response.status === 401, `expected=401 actual=${response.status}`));
    client.test("공통 실패 본문", () => {
        client.assert(response.body.code === "UNAUTHORIZED", "code");
        client.assert(response.body.status === response.status, "status");
        client.assert(typeof response.body.timestamp === "string" && !isNaN(Date.parse(response.body.timestamp)), "timestamp");
        client.assert(typeof response.body.message === "string", "message");
        client.assert(response.body.path === "/internal/notifications", "path");
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0, "details");
    });
%}

### 필수 필드 누락
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{}

> {%
    client.test("입력 거절", () => client.assert(response.status === 400, `expected=400 actual=${response.status}`));
    client.test("공통 실패 본문", () => {
        client.assert(response.body.code === "BAD_REQUEST", "code");
        client.assert(response.body.status === response.status, "status");
        client.assert(typeof response.body.timestamp === "string" && !isNaN(Date.parse(response.body.timestamp)), "timestamp");
        client.assert(typeof response.body.message === "string", "message");
        client.assert(response.body.path === "/internal/notifications", "path");
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0, "details");
    });
%}

### 자유 발송: 회원 자격과 FCM 설정에 따른 결과 및 건수를 확인
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
X-Manyak-Request-Id: req_manual_notification
X-Manyak-Session-Id: session_manual_notification
X-Manyak-Device-Id-Hash: device_hash_0123456789abcdef
Content-Type: application/json

{
  "recipientId":"{{recipientId}}",
  "kind":"SERVICE",
  "type":"STORY_COMPLETED",
  "data":{"title":"스토리 완성","body":"테스트 알림","deepLink":"https://manyak.app"}
}

### 서버 URL을 비우고 알림 서비스를 재시작한 후 별도 실행
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{"recipientId":"{{recipientId}}","kind":"SERVICE","type":"STORY_COMPLETED","data":{}}

> {%
    client.test("자격 조회 실패", () => client.assert(response.status === 502 && response.body.outcome === "FAILED", `expected=502/FAILED actual=${response.status}/${response.body.outcome}`));
%}

### 시크릿을 비우고 알림 서비스를 재시작한 후 별도 실행
POST {{baseUrl}}/internal/notifications

> {%
    client.test("내부 API 비활성", () => client.assert(response.status === 404, `expected=404 actual=${response.status}`));
    client.test("공통 실패 본문", () => {
        client.assert(response.body.code === "NOT_FOUND", "code");
        client.assert(response.body.status === response.status, "status");
        client.assert(typeof response.body.timestamp === "string" && !isNaN(Date.parse(response.body.timestamp)), "timestamp");
        client.assert(typeof response.body.message === "string", "message");
        client.assert(response.body.path === "/internal/notifications", "path");
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0, "details");
    });
%}

### 선언적 검증 실패: details에 type 필드 오류 포함
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{"recipientId":"{{recipientId}}","kind":"SERVICE","type":" ","data":{}}

> {%
    client.test("필드 검증", () => {
        client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", "400/BAD_REQUEST");
        client.assert(response.body.details.some(detail => detail.field === "type" && detail.message), "type 오류");
    });
%}

### 본문 파싱 실패: details는 빈 배열
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{"recipientId":"invalid","kind":"SERVICE","type":"STORY_COMPLETED","data":{}}

> {%
    client.test("본문 파싱 실패", () => {
        client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", "400/BAD_REQUEST");
        client.assert(Array.isArray(response.body.details) && response.body.details.length === 0, "빈 details");
    });
%}

### 허용되지 않은 메서드: 공통 실패 본문과 Allow 헤더
GET {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}

> {%
    client.test("405 공통 실패", () => {
        client.assert(response.status === 405 && response.body.code === "METHOD_NOT_ALLOWED", "405/METHOD_NOT_ALLOWED");
        client.assert(response.body.status === 405 && Array.isArray(response.body.details), "공통 본문");
    });
%}

### 지원하지 않는 본문 형식
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: text/plain

{}

> {%
    client.test("415 공통 실패", () => client.assert(response.status === 415 && response.body.code === "UNSUPPORTED_MEDIA_TYPE", "415/UNSUPPORTED_MEDIA_TYPE"));
%}

### 매핑 없는 경로
GET {{baseUrl}}/internal/no-mapping
X-Manyak-Internal-Secret: {{internalSecret}}

> {%
    client.test("404 공통 실패", () => client.assert(response.status === 404 && response.body.code === "NOT_FOUND", "404/NOT_FOUND"));
%}

### 필터에서 거절하는 잘못된 form
PUT {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
X-Manyak-Request-Id: req-outside-mvc
Content-Type: application/x-www-form-urlencoded
Accept: application/json

a=%ZZ

> {%
    client.test("공통 실패 본문", () => {
        client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", "400/BAD_REQUEST");
        client.assert(response.body.path === "/internal/notifications" && Array.isArray(response.body.details), "공통 본문");
        client.assert(response.headers.valueOf("X-Manyak-Request-Id") === "req-outside-mvc", "상관 ID");
    });
%}

### JSON을 제외한 Accept의 잘못된 form
PUT {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
X-Manyak-Request-Id: req-outside-mvc
Content-Type: application/x-www-form-urlencoded
Accept: image/png

a=%ZZ

> {%
    client.test("공통 실패 본문", () => {
        client.assert(response.status === 400 && response.body.code === "BAD_REQUEST", "400/BAD_REQUEST");
        client.assert(response.body.path === "/internal/notifications" && Array.isArray(response.body.details), "공통 본문");
        client.assert(response.headers.valueOf("X-Manyak-Request-Id") === "req-outside-mvc", "상관 ID");
    });
%}

### 컨테이너의 TRACE 거절
TRACE {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
X-Manyak-Request-Id: req-outside-mvc
Content-Type: application/x-www-form-urlencoded
Accept: image/png



> {%
    client.test("공통 실패 본문", () => {
        client.assert(response.status === 405 && response.body.code === "METHOD_NOT_ALLOWED", "405/METHOD_NOT_ALLOWED");
        client.assert(response.body.path === "/internal/notifications" && Array.isArray(response.body.details), "공통 본문");
        client.assert(response.headers.valueOf("X-Manyak-Request-Id") === "req-outside-mvc", "상관 ID");
    });
%}

### 정보성 공지: SERVICE 자격, 광고 표기 없는 문구와 공지 딥링크
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{
  "recipientId": "{{recipientId}}", "kind": "SERVICE", "type": "NOTICE",
  "data": {
    "type": "NOTICE", "campaignId": "00000000-0000-4000-8000-000000000002",
    "noticeId": "00000000-0000-4000-8000-000000000003", "title": "공지", "body": "공지 본문",
    "deepLink": "https://manyak.app/notices/00000000-0000-4000-8000-000000000003"
  }
}

### 스토리 이동 캠페인: MARKETING 자격과 스토리 딥링크
POST {{baseUrl}}/internal/notifications
X-Manyak-Internal-Secret: {{internalSecret}}
Content-Type: application/json

{
  "recipientId": "{{recipientId}}", "kind": "MARKETING", "type": "PROMOTION",
  "data": {
    "type": "PROMOTION", "campaignId": "00000000-0000-4000-8000-000000000002",
    "storyId": "00000000-0000-4000-8000-000000000004", "title": "(광고) 새 스토리", "body": "스토리를 확인하세요",
    "deepLink": "https://manyak.app/stories/00000000-0000-4000-8000-000000000004"
  }
}

### 서버 결과 보고 API 수동 확인: 서버 주소에 호출, 동기 발송 API는 보고하지 않음
### 테스트용 messageId로 결과 행이 생성되며 같은 ID 재보고는 처음 행을 유지함
POST {{serverBaseUrl}}/internal/push-deliveries
X-Manyak-Internal-Secret: {{internalSecret}}
X-Manyak-Request-Id: req_manual_delivery
Content-Type: application/json

{
  "messageId": "story-completed:00000000-0000-4000-8000-000000000005",
  "recipientId": "{{recipientId}}", "type": "STORY_COMPLETED", "kind": "SERVICE",
  "outcome": "DELIVERED", "reason": "OK", "deliveredDevices": 2, "failedDevices": 0,
  "completedAt": "2026-10-22T01:00:00Z"
}

> {%
    client.test("보고 수락", () => client.assert(response.status === 204, "204"));
%}
